# Resend (https://resend.com) — API key and verified sender
RESEND_API_KEY=
# Sender must belong to a domain verified in Resend (e.g. "Vitalitty Web <web@vitalitty.es>").
# Defaults to Resend's sandbox sender, which only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=
# Mailbox that receives contact form submissions
CONTACT_TO_EMAIL=

# Cloudflare Turnstile. For local testing use Cloudflare's always-pass test keys:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
