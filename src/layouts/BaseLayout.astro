---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  /** Path under /public or absolute URL. Defaults to the Wix share image. */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: 'website' | 'article';
  ogUrl?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  canonicalUrl?: string;
  noindex?: boolean;
}

const DEFAULT_OG_IMAGE = {
  src: '/images/og-default.jpg',
  width: 677,
  height: 589,
};

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  twitterCard = 'summary_large_image',
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);

/** Wix canonicals have no trailing slash (home is the bare origin). */
function toCanonical(pathname: string): string {
  const trimmed = pathname.replace(/\/+$/, '');
  return trimmed ? new URL(trimmed, site).href : site.origin;
}

const canonical = Astro.props.canonicalUrl ?? toCanonical(Astro.url.pathname);
const ogUrl = Astro.props.ogUrl ?? canonical;
const image = ogImage
  ? { src: ogImage, width: ogImageWidth, height: ogImageHeight }
  : DEFAULT_OG_IMAGE;
const imageUrl = new URL(image.src, site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta
      name="google-site-verification"
      content="pRc_GRyRyJTFrSEwiGyqWU_UMfOcqtj1KFXE9Zr1AEA"
    />

    <meta property="og:site_name" content="Vitalitty" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      image.width && (
        <meta property="og:image:width" content={String(image.width)} />
      )
    }
    {
      image.height && (
        <meta property="og:image:height" content={String(image.height)} />
      )
    }
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body class="flex min-h-screen flex-col bg-bg font-body text-text">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
