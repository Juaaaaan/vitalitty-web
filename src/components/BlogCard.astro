---
import { Image } from 'astro:assets';
import { formatDate, postUrl, searchText, type Post } from '../lib/blog';

interface Props {
  post: Post;
  /** Eager-load the first row of cards. */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const { title, description, image, author, date } = post.data;
---

<article
  class="group flex h-full flex-col border border-border bg-bg"
  data-post-card
  data-search={searchText(post)}
>
  <a
    href={postUrl(post)}
    class="block overflow-hidden"
    tabindex="-1"
    aria-hidden="true"
  >
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={[320, 640]}
          sizes="(max-width: 640px) 100vw, 300px"
          loading={eager ? 'eager' : 'lazy'}
          class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <div class="aspect-[4/3] w-full bg-bg-alt" />
      )
    }
  </a>
  <div class="flex flex-1 flex-col px-6 pt-5 pb-8">
    <p class="text-xs text-text-muted">
      <span>{author}</span>
      <span class="block"
        ><time datetime={date.toISOString()}>{formatDate(date)}</time></span
      >
    </p>
    <h2 class="mt-5 font-heading text-xl leading-snug font-normal">
      <a
        href={postUrl(post)}
        class="text-text after:absolute after:inset-0 hover:text-primary-dark focus-visible:underline"
      >
        {title}
      </a>
    </h2>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-text-muted">
      {description}
    </p>
  </div>
</article>
