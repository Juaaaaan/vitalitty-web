---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  id?: string;
  /** Banner background. Without it the title renders as a plain heading. */
  image?: ImageMetadata;
}

const { title, id, image } = Astro.props;
---

{
  image ? (
    <section class="px-4 pt-8" id={id}>
      <div class="relative mx-auto flex min-h-[220px] max-w-[980px] items-center justify-center overflow-hidden md:min-h-[335px]">
        <Image
          src={image}
          alt=""
          widths={[640, 980, 1960]}
          sizes="(max-width: 980px) 100vw, 980px"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <h1 class="relative mx-4 bg-bg/60 px-6 py-4 text-center font-heading text-4xl font-normal tracking-wide text-text md:px-7 md:text-[56px]">
          {title}
        </h1>
      </div>
    </section>
  ) : (
    <section class="px-4 pt-12 pb-8 md:pt-16" id={id}>
      <h1 class="text-center font-heading text-4xl font-normal tracking-wide text-text md:text-[56px]">
        {title}
      </h1>
    </section>
  )
}
