---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-vitalitty.jpg';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-bg border-b border-border">
  <div
    class="relative mx-auto flex max-w-[980px] items-center justify-between px-4 py-3 md:flex-col md:justify-center md:gap-3 md:pb-4"
  >
    <a href="/" class="shrink-0">
      <Image
        src={logo}
        alt="Vitalitty - Nutrición y Fisioterapia"
        width={57}
        height={50}
        densities={[1, 2]}
        loading="eager"
        class="h-[50px] w-auto"
      />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="block h-0.5 w-6 bg-text transition-transform" id="bar1"
      ></span>
      <span class="block h-0.5 w-6 bg-text transition-opacity" id="bar2"></span>
      <span class="block h-0.5 w-6 bg-text transition-transform" id="bar3"
      ></span>
    </button>

    <nav
      id="main-nav"
      class="absolute left-0 top-full hidden w-full bg-bg shadow-lg md:static md:block md:w-auto md:shadow-none"
      aria-label="Navegación principal"
    >
      <ul class="flex flex-col items-center gap-0 md:flex-row md:gap-12">
        <li>
          <a
            href="/"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/' ? 'text-primary-dark' : 'text-text',
            ]}
          >
            Inicio
          </a>
        </li>
        <li>
          <a
            href="/#conocenos"
            class="block px-4 py-3 text-sm font-heading tracking-wide text-text transition-colors hover:text-primary-dark md:px-0 md:py-0"
          >
            Conócenos
          </a>
        </li>
        <li class="group relative">
          <button
            type="button"
            id="servicios-toggle"
            aria-expanded="false"
            aria-controls="servicios-menu"
            class="flex w-full items-center gap-1 px-4 py-3 text-sm font-heading tracking-wide text-text transition-colors hover:text-primary-dark md:px-0 md:py-0"
          >
            Servicios
            <svg
              class="h-3 w-3 transition-transform group-hover:rotate-180 group-data-[open]:rotate-180"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 5l3 3 3-3"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul
            id="servicios-menu"
            class="hidden bg-bg py-2 shadow-lg data-[open]:block md:group-hover:block md:absolute md:left-0 md:top-full md:min-w-[180px] md:rounded-md"
          >
            <li>
              <a
                href="/nutricion"
                class="block px-6 py-2 text-sm text-text transition-colors hover:bg-bg-alt hover:text-primary-dark"
              >
                Nutrición
              </a>
            </li>
            <li>
              <a
                href="/fisioterapia"
                class="block px-6 py-2 text-sm text-text transition-colors hover:bg-bg-alt hover:text-primary-dark"
              >
                Fisioterapia
              </a>
            </li>
          </ul>
        </li>
        <li>
          <a
            href="/colaboraciones"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/colaboraciones'
                ? 'text-primary-dark'
                : 'text-text',
            ]}
          >
            Colaboraciones
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath.startsWith('/blog')
                ? 'text-primary-dark'
                : 'text-text',
            ]}
          >
            Blog
          </a>
        </li>
        <li>
          <a
            href="/contacto"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/contacto' ? 'text-primary-dark' : 'text-text',
            ]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>

    <div
      class="hidden items-center gap-3 md:absolute md:top-6 md:right-4 md:flex"
    >
      <a
        href="https://www.instagram.com/vitalittylive/?hl=es"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Vitalitty en Instagram"
        class="text-text transition-colors hover:text-primary-dark"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
          ></path>
        </svg>
      </a>
      <a
        href="http://tiktok.com/@vitalittynutri"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Vitalitty en TikTok"
        class="text-text transition-colors hover:text-primary-dark"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13a8.24 8.24 0 005.58 2.17V11.7a4.85 4.85 0 01-3.77-1.78V6.69h3.77z"
          ></path>
        </svg>
      </a>
      <a
        href="https://youtube.com/channel/UCVTJ-jyelsqhBANnvEDYLUA"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Vitalitty en YouTube"
        class="text-text transition-colors hover:text-primary-dark"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
          ></path>
        </svg>
      </a>
      <a
        href="https://es-es.facebook.com/vitalittylive/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Vitalitty en Facebook"
        class="text-text transition-colors hover:text-primary-dark"
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden');

    if (!expanded) {
      bar1?.classList.add('translate-y-2', 'rotate-45');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-translate-y-2', '-rotate-45');
    } else {
      bar1?.classList.remove('translate-y-2', 'rotate-45');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-translate-y-2', '-rotate-45');
    }
  });

  const serviciosToggle = document.getElementById('servicios-toggle');
  const serviciosMenu = document.getElementById('servicios-menu');
  const serviciosItem = serviciosToggle?.parentElement;

  const setServicios = (open: boolean) => {
    serviciosToggle?.setAttribute('aria-expanded', String(open));
    serviciosMenu?.toggleAttribute('data-open', open);
    serviciosItem?.toggleAttribute('data-open', open);
  };

  serviciosToggle?.addEventListener('click', () =>
    setServicios(serviciosToggle.getAttribute('aria-expanded') !== 'true'),
  );
  serviciosItem?.addEventListener('focusout', (event) => {
    if (!serviciosItem.contains(event.relatedTarget as Node))
      setServicios(false);
  });
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      serviciosToggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setServicios(false);
      serviciosToggle.focus();
    }
  });
</script>
