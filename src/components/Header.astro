---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-vitalitty.jpg';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-bg border-b border-border">
  <!-- max-w 1012px - px-4 (32px) = 980px nav width, as requested -->
  <div
    class="relative mx-auto flex max-w-[1012px] items-center justify-between px-4 py-3 md:flex-col md:justify-center md:gap-3 md:pb-4"
  >
    <a href="/" class="shrink-0">
      <Image
        src={logo}
        alt="Vitalitty - Nutrición y Fisioterapia"
        width={57}
        height={50}
        densities={[1, 2]}
        loading="eager"
        class="h-[50px] w-auto"
      />
    </a>

    <button
      id="menu-toggle"
      type="button"
      class="flex flex-col gap-1.5 p-2 md:hidden"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="block h-0.5 w-6 bg-text transition-transform" id="bar1"
      ></span>
      <span class="block h-0.5 w-6 bg-text transition-opacity" id="bar2"></span>
      <span class="block h-0.5 w-6 bg-text transition-transform" id="bar3"
      ></span>
    </button>

    <nav
      id="main-nav"
      class="absolute left-0 top-full hidden w-full bg-bg shadow-lg md:static md:block md:shadow-none"
      aria-label="Navegación principal"
    >
      <ul
        class="flex flex-col items-center gap-0 md:flex-row md:justify-between"
      >
        <li>
          <a
            href="/"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/' ? 'text-primary-dark' : 'text-text',
            ]}
          >
            Inicio
          </a>
        </li>
        <li>
          <a
            href="/#conocenos"
            class="block px-4 py-3 text-sm font-heading tracking-wide text-text transition-colors hover:text-primary-dark md:px-0 md:py-0"
          >
            Conócenos
          </a>
        </li>
        <li class="group relative">
          <button
            type="button"
            id="servicios-toggle"
            aria-expanded="false"
            aria-controls="servicios-menu"
            class="flex w-full items-center gap-1 px-4 py-3 text-sm font-heading tracking-wide text-text transition-colors hover:text-primary-dark md:px-0 md:py-0"
          >
            Servicios
            <svg
              class="h-3 w-3 transition-transform group-hover:rotate-180 group-data-[open]:rotate-180"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 5l3 3 3-3"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <ul
            id="servicios-menu"
            class="hidden bg-bg py-2 shadow-lg data-[open]:block md:group-hover:block md:absolute md:left-0 md:top-full md:min-w-[180px] md:rounded-md"
          >
            <li>
              <a
                href="/nutricion"
                class="block px-6 py-2 text-sm text-text transition-colors hover:bg-bg-alt hover:text-primary-dark"
              >
                Nutrición
              </a>
            </li>
            <li>
              <a
                href="/fisioterapia"
                class="block px-6 py-2 text-sm text-text transition-colors hover:bg-bg-alt hover:text-primary-dark"
              >
                Fisioterapia
              </a>
            </li>
          </ul>
        </li>
        <li>
          <a
            href="/colaboraciones"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/colaboraciones'
                ? 'text-primary-dark'
                : 'text-text',
            ]}
          >
            Colaboraciones
          </a>
        </li>
        <li>
          <a
            href="/blog"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath.startsWith('/blog')
                ? 'text-primary-dark'
                : 'text-text',
            ]}
          >
            Blog
          </a>
        </li>
        <li>
          <a
            href="/contacto"
            class:list={[
              'block px-4 py-3 text-sm font-heading tracking-wide transition-colors hover:text-primary-dark md:px-0 md:py-0',
              currentPath === '/contacto' ? 'text-primary-dark' : 'text-text',
            ]}
          >
            Contacto
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  const bar1 = document.getElementById('bar1');
  const bar2 = document.getElementById('bar2');
  const bar3 = document.getElementById('bar3');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden');

    if (!expanded) {
      bar1?.classList.add('translate-y-2', 'rotate-45');
      bar2?.classList.add('opacity-0');
      bar3?.classList.add('-translate-y-2', '-rotate-45');
    } else {
      bar1?.classList.remove('translate-y-2', 'rotate-45');
      bar2?.classList.remove('opacity-0');
      bar3?.classList.remove('-translate-y-2', '-rotate-45');
    }
  });

  const serviciosToggle = document.getElementById('servicios-toggle');
  const serviciosMenu = document.getElementById('servicios-menu');
  const serviciosItem = serviciosToggle?.parentElement;

  const setServicios = (open: boolean) => {
    serviciosToggle?.setAttribute('aria-expanded', String(open));
    serviciosMenu?.toggleAttribute('data-open', open);
    serviciosItem?.toggleAttribute('data-open', open);
  };

  serviciosToggle?.addEventListener('click', () =>
    setServicios(serviciosToggle.getAttribute('aria-expanded') !== 'true'),
  );
  serviciosItem?.addEventListener('focusout', (event) => {
    if (!serviciosItem.contains(event.relatedTarget as Node))
      setServicios(false);
  });
  document.addEventListener('keydown', (event) => {
    if (
      event.key === 'Escape' &&
      serviciosToggle?.getAttribute('aria-expanded') === 'true'
    ) {
      setServicios(false);
      serviciosToggle.focus();
    }
  });
</script>
