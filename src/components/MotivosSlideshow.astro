---
import { Image } from 'astro:assets';
import fondo from '../assets/images/porque-nosotros.jpg';
import type { Motivo } from '../lib/types';

interface Props {
  motivos: Motivo[];
  autoplay?: number;
}

const { motivos, autoplay = 6000 } = Astro.props;
---

<section class="px-4 pt-12 pb-4" aria-labelledby="porque-nosotros-title">
  <div class="mx-auto max-w-[980px]">
    <h2
      id="porque-nosotros-title"
      class="text-center font-heading text-3xl font-normal"
    >
      ¿Por qué nosotros?
    </h2>
    <p class="mt-3 text-center font-heading text-xl">
      Descubre nuestra diferencia
    </p>

    <snap-carousel
      class="relative mt-8 block overflow-hidden text-bg"
      data-autoplay={autoplay}
      data-dot-label="Ver motivo"
      aria-roledescription="carrusel"
      aria-label="Por qué elegir Vitalitty"
    >
      <Image
        src={fondo}
        alt=""
        widths={[640, 980, 1960]}
        sizes="(max-width: 980px) 100vw, 980px"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-text/55" aria-hidden="true"></div>

      <div class="carousel-track relative" data-track tabindex="0">
        {
          motivos.map((m, i) => (
            <div
              data-slide
              class="flex min-h-[360px] flex-col items-center justify-center px-16 py-12 text-center"
              aria-roledescription="diapositiva"
              aria-label={`${i + 1} de ${motivos.length}`}
            >
              <h3 class="font-heading text-2xl font-normal tracking-widest md:text-3xl">
                {m.titulo}
              </h3>
              <p class="mt-4 max-w-[560px] text-lg leading-relaxed">
                {m.texto}
              </p>
            </div>
          ))
        }
      </div>

      <button
        type="button"
        data-prev
        class="absolute top-1/2 left-4 -translate-y-1/2 p-2 transition-opacity hover:opacity-70"
        aria-label="Motivo anterior"
      >
        <svg
          class="h-10 w-5"
          viewBox="0 0 20 40"
          fill="none"
          aria-hidden="true"
        >
          <path d="M18 2 2 20l16 18" stroke="currentColor" stroke-width="1.5"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        data-next
        class="absolute top-1/2 right-4 -translate-y-1/2 p-2 transition-opacity hover:opacity-70"
        aria-label="Motivo siguiente"
      >
        <svg
          class="h-10 w-5"
          viewBox="0 0 20 40"
          fill="none"
          aria-hidden="true"
        >
          <path d="m2 2 16 18L2 38" stroke="currentColor" stroke-width="1.5"
          ></path>
        </svg>
      </button>

      <div
        class="absolute bottom-5 left-0 flex w-full justify-center"
        data-dots
      >
      </div>
    </snap-carousel>
  </div>
</section>

<script>
  import '../scripts/carousel';
</script>
