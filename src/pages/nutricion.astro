---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import banner from '../assets/images/banners/nutricion.jpg';
import ServiceCard from '../components/ServiceCard.astro';
import servicios from '../data/servicios-nutricion.json';

const seo = {
  title: 'Nutrición | Vitalitty',
  description:
    'En vitalitty te asesoramos para que puedas cumplir tus objetivos. Jesús Arsenio, experto nutricionista te enseñará principios básicos de la nutrición y cómo mejorar la ingesta de nutrientes',
};
---

<BaseLayout {...seo} twitterCard="summary">
  <PageHeader title="Nutrición" id="nutricin" image={banner} />

  <section class="px-4 pb-12" aria-label="Servicios de nutrición">
    <div
      class="mx-auto grid max-w-[980px] gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-3"
    >
      {servicios.map((servicio) => <ServiceCard servicio={servicio} />)}
    </div>
  </section>
</BaseLayout>
